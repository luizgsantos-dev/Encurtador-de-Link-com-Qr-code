# Banco de dados
POSTGRES_USER=shortener
POSTGRES_PASSWORD=changeme
POSTGRES_DB=shortener
DATABASE_URL=postgresql+asyncpg://shortener:changeme@db:5432/shortener

# Autenticação - cria o usuário admin inicial se o banco ainda não tiver nenhum usuário
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=changeme-generate-a-long-random-string

# URL pública usada para montar os links curtos e o QR code
BASE_URL=http://localhost:8080

# Porta exposta no host para o painel/redirecionador
WEB_PORT=8080

# true quando servido atrás de HTTPS (cookie Secure)
COOKIE_SECURE=false
